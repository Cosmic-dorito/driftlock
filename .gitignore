# Testing / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Generated data.
# POLICY: data/bench/ IS committed - it is the required >=30-pair validation evidence.
# Every other split is regenerated from seeds via `make data` and never committed.
data/*
!data/bench/
!data/bench/**
data/_sponsor/

# Third-party reference generator, fetched not vendored.
# See scripts/fetch_reference_generator.sh and README attribution.
third_party/

# Packaging output
dist/
*.zip

# Large or transient results. Committed results live in results/ as CSV/MD/PNG;
# scratch runs go to results/_scratch/.
results/_scratch/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# Office/LibreOffice lock files
~$*

# Stale fallback deck written by make_deck.py when the real one is locked by an open
# PowerPoint/LibreOffice window. Never a deliverable; it is stale as soon as the real deck rebuilds.
*.rebuilt.pptx
data/_stress/

# Regenerable cache: scripts/pose_evidence.py --capture rebuilds it from the pipeline.
# It is an input to an analysis, not a result, and it is ~0.8 MB of derived numbers.
results/pose_grids.json

dist/deckqa/

.claude/
